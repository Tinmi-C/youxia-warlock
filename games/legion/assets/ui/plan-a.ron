// Plan A "Iron & Gold" (铁金条约) — the boarded UI design-system skin.
// LG3 换肤复用：此文件是 loop-td `assets/ui/plan-a.ron` 的逐字拷贝（ boarded
// 拍板 2026-10-27, engine/warbase/docs/ui-design-brief.md）——同一套 token 供
// 军团图六面板消费，"换肤复用成本" 的度量对象（见 docs/kpi.md LG3 行）。
//
// Unlisted fields fall back to the `UiTheme` defaults (serde(default)).
(
    revision: 1,
    palette: (
        // Dark iron base + gold trim — classic WC3 console.
        panel_bg: ( r: 0.10, g: 0.09, b: 0.08, a: 0.94 ),
        panel_raised: ( r: 0.18, g: 0.16, b: 0.13 ),
        panel_border: ( r: 0.52, g: 0.40, b: 0.18 ),
        text_primary: ( r: 0.98, g: 0.95, b: 0.86 ),
        text_secondary: ( r: 0.76, g: 0.70, b: 0.58 ),
        text_dim: ( r: 0.46, g: 0.42, b: 0.36 ),
        accent: ( r: 1.0, g: 0.80, b: 0.28 ),
    ),
    state_colors: (
        slot_disabled_bg: ( r: 0.13, g: 0.12, b: 0.11 ),
        tooltip_bg: ( r: 0.07, g: 0.06, b: 0.05, a: 0.96 ),
    ),
    typography: (
        font_value: 22.0,
        font_label: 15.0,
        font_caption: 11.0,
        font_badge: 10.0,
        font_tooltip: 13.0,
        font_title: 16.0,
    ),
    spacing: (
        panel_margin: 6.0,
        panel_gap: 5.0,
        slot_w: 78.0,
        slot_h: 38.0,
        slot_pad: 4.0,
        panel_border_w: 2.0,
        slot_border_w: 1.0,
        tooltip_bottom: 152.0,
        tooltip_left: 226.0,
        tooltip_pad: 7.0,
        badge_top: 1.0,
        badge_right: 3.0,
        bar_h: 12.0,
        icon_size: 16.0,
    ),
    radius: ( panel: 3.0, slot: 2.0, pill: 999.0 ),
)
