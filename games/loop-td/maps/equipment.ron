// LT2 装备表（游戏侧补充装载，load_map 时并入内存 bundle）：
// 词缀走 ItemDef.passive（攻+X% / 间隔-X%）；射程词缀走游戏侧
// systems/equip.rs 的 RANGE_AFFIXES 表——基底 StatKind 无射程项，已记洞。
// 不并入 loop.ron 正文的原因：engine seam 测试
// (warbase/tests/seam.rs::old_map_without_new_sections_loads) 钉死
// shipped maps 的 items 节为空（pre-ADR-0016 兼容契约），引擎冻结不可改，
// 故装备定义独立成文件、装载期合并（重启经 CurrentMap 克隆同样保留）。
(
    items: {
        "blade12": (id: "blade12", name: "精锻利刃", kind: Passive, charges: None, passive: Some((kind: DamageMult, amount: 0.12)), cost_gold: 90),
        "blade08": (id: "blade08", name: "制式利刃", kind: Passive, charges: None, passive: Some((kind: DamageMult, amount: 0.08)), cost_gold: 60),
        "quiver":  (id: "quiver",  name: "疾风箭袋", kind: Passive, charges: None, passive: Some((kind: AttackIntervalMult, amount: -0.10)), cost_gold: 70),
        "scope":   (id: "scope",   name: "观测镜",   kind: Passive, charges: None, cost_gold: 70),
    },
    drops: {},
)
