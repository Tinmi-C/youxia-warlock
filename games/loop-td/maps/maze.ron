            (spawns: [(unit: "grunt",  count: 16, interval: 0.4, path: 0, hp_scale: 2.3), (unit: "brute", count: 3, interval: 1.5, path: 0, hp_scale: 2.0)], boss_timeout: None, preview: "heavy swarm", reward_gold: 90),
            (spawns: [(unit: "runner", count: 14, interval: 0.3, path: 0, hp_scale: 2.6)],  boss_timeout: None, preview: "runners x14", reward_gold: 95),
            (spawns: [(unit: "brute",  count: 8,  interval: 0.8, path: 0, hp_scale: 2.3)],  boss_timeout: None, preview: "8 brutes", reward_gold: 100),
            (spawns: [(unit: "flyer",  count: 14, interval: 0.25, path: 0, hp_scale: 2.6)], boss_timeout: None, preview: "air x14", reward_gold: 105),
            (spawns: [(unit: "grunt",  count: 18, interval: 0.3, path: 0, hp_scale: 2.6), (unit: "runner", count: 8, interval: 0.3, path: 0, hp_scale: 2.6)], boss_timeout: None, preview: "final swarm", reward_gold: 110),
            (spawns: [(unit: "titan",  count: 2,  interval: 3.0, path: 0, hp_scale: 1.25), (unit: "brute", count: 6, interval: 1.0, path: 0, hp_scale: 2.6)], boss_timeout: Some(90.0), preview: "TWIN TITANS", reward_gold: 200),
        ],
        advance: Auto(intermission: 10.0),
        early_call_bonus: Some(20),
    ),
    rules: (
        leak: Lives(lives: 10),
        build_window: Always,
        lap_buff: None,
        win: SurviveWaves(waves: 20),
        sell_refund_pct: 0.7,
    ),
    econ_start: (gold: 150, wood: 0, pop_cap: 10),
    econ_rules: (wood_to_gold: 25, pop_cost_base: 2, pop_cost_growth: 1.5, pop_gain: 2),
    attack_armor: (
        mult: (
            (1.0,  1.0,  1.0,  0.7,  1.0, 0.05),
            (1.5,  1.0,  0.75, 0.35, 1.0, 0.05),
            (1.0,  1.0,  1.5,  1.5,  0.5, 0.05),
