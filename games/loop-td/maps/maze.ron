                   armor_type: Fortified, cost_gold: 90, bounty_gold: 0, grant_xp: 0, traits: [], upgrade_to: Some("arrow3")),
        "arrow3": (id: "arrow3", attrs: (hp: 150, move_speed: 0.0, body_radius: 0.5),
