                   auras: [(radius: 3.0, kind: MoveSpeedMult, amount: -0.25)]),
        // ---- 迷宫敌人 ----
        "grunt":  (id: "grunt", attrs: (hp: 50, move_speed: 1.2, body_radius: 0.3),
