// 迷宫 TD 正式版：S 形弯路（路径长度 ~44 单位）+ Lives 规则 + 20 波
// 与 loop.ron（闭环/存量/Auto）成对照：开链/扣命/Manual——同基底不同玩法。
(
    identity: (id: "maze", version: 1),
    world: (
        paths: [
            // S-shaped winding path: entry left → zigzag → exit right
            (
                points: [
                    (-12.0, -4.0), (-4.0, -4.0), (-4.0, 2.0), (4.0, 2.0),
                    (4.0, -4.0), (12.0, -4.0), (12.0, 4.0), (-12.0, 4.0),
                    (-12.0, 8.0), (12.0, 8.0),
                ],
                closed: false,
            ),
        ],
        build: FreeGrid(cell: 1.0, cols: 28, rows: 16),
        blocked: [],
    ),
    units: {
        // ---- 塔复用 loop 的体系 + 迷宫专属 ----
        "arrow":  (id: "arrow",  attrs: (hp: 80, move_speed: 0.0, body_radius: 0.4),
                   attack: Some((damage: 12, interval: 0.8, range: 4.5, attack_type: Piercing, targets: Both, projectile: Some((speed: 20.0)))),
                   armor_type: Fortified, cost_gold: 50, bounty_gold: 0, grant_xp: 0, traits: [], upgrade_to: Some("arrow2")),
        "arrow2": (id: "arrow2", attrs: (hp: 110, move_speed: 0.0, body_radius: 0.45),
