            (spawns: [(unit: "brute",  count: 4,  interval: 1.5, path: 0, hp_scale: 1.52), (unit: "mender", count: 2, interval: 3.0, path: 0, hp_scale: 1.52)], boss_timeout: None, preview: "brutes+menders", reward_gold: 65),
            (spawns: [(unit: "titan",  count: 1,  interval: 1.0, path: 0, hp_scale: 1.0), (unit: "grunt", count: 8, interval: 0.6, path: 0, hp_scale: 2.0)], boss_timeout: Some(60.0), preview: "TITAN", reward_gold: 100),
            (spawns: [(unit: "grunt",  count: 14, interval: 0.4, path: 0, hp_scale: 2.0)],  boss_timeout: None, preview: "14 grunts", reward_gold: 70),
            (spawns: [(unit: "runner", count: 12, interval: 0.3, path: 0, hp_scale: 2.0)],  boss_timeout: None, preview: "runners x12", reward_gold: 75),
