                   armor_type: Fortified, cost_gold: 80, bounty_gold: 0, grant_xp: 0, traits: [], upgrade_to: Some("cannon2")),
        "cannon2": (id: "cannon2", attrs: (hp: 170, move_speed: 0.0, body_radius: 0.55),
                   attack: Some((damage: 60, interval: 1.4, range: 4.0, attack_type: Siege, targets: Ground, projectile: Some((speed: 18.0)))),
                   armor_type: Fortified, cost_gold: 140, bounty_gold: 0, grant_xp: 0, traits: []),
        "ice":     (id: "ice", attrs: (hp: 70, move_speed: 0.0, body_radius: 0.4),
